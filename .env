# ===========================================
# MCP Ecosystem 환경 설정
# ===========================================
# 이 파일을 .env로 복사하여 사용하세요.
# cp .env.example .env

# [Application]
APP_NAME=mcps
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
BASE_DIR=/app/poc/mcps

# [Python]
PYTHON_PATH=/app/miniconda3/envs/mcp_env/bin/python
PYTHON_VERSION=3.10.19

# [OS]
REDHAT_SUPPORT_PRODUCT=RockyLinux
REDHAT_SUPPORT_PRODUCT_VERSION=8.10

# ===========================================
# Database - MariaDB
# ===========================================
MARIADB_HOST=L4
MARIADB_PORT=2503
MARIADB_USER=aia
MARIADB_PASSWORD=aia123!
MARIADB_DATABASE=mcps_db
MARIADB_CHARSET=utf8mb4
MARIADB_SSL=0
MARIADB_CONNECT_TIMEOUT=10
MARIADB_READ_TIMEOUT=30
MARIADB_WRITE_TIMEOUT=30
MARIADB_POOL_MIN=5
MARIADB_POOL_MAX=20
MARIADB_CONNECT_CLI=/usr/local/bin/mysql -uaia -paia123! -P2503 -hL4 --ssl=0 -Dmcps_db

# ===========================================
# Elasticsearch
# ===========================================
ES_HOST=http://shbank.kro.kr:39200
ES_USER=ciq_admin
ES_PASSWORD=shinhan@2
ES_SSL_ENABLE=N
ES_SSL_VERIFY_SKIP=Y
ES_TIMEOUT=30
ES_INDEX_PREFIX=mcps

# ===========================================
# Network - Services
# ===========================================
API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_PORT=8000
MCP_HOST_HOST=127.0.0.1
MCP_HOST_PORT=8080
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=8501

# ===========================================
# JWT Authentication
# ===========================================
JWT_SECRET_KEY=mcps_secret_key_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_DIR=/app/poc/mcps/data/logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10

# ===========================================
# Cache
# ===========================================
CACHE_MAX_SIZE=1000
CACHE_DEFAULT_TTL=300

# ===========================================
# MCP Protocol
# ===========================================
MCP_STDIO_TIMEOUT=30
MCP_SERVER_RESTART_DELAY=5

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_PER_MINUTE=100
