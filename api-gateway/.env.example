# Environment
ENVIRONMENT=production
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO

# MCP Host
MCP_HOST_URL=http://localhost:8000
MCP_HOST_TIMEOUT=30

# Database (optional - mostly use MCP Host)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mcps_db
DB_USER=mcps_user
DB_PASSWORD=your_db_password_here

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# JWT
JWT_SECRET_KEY=your-secret-key-change-me-in-production-use-strong-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# Caching
CACHE_ENABLED=true
CACHE_TTL=300

# Metrics
METRICS_ENABLED=false
